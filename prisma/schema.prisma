generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  key       String   @unique
  createdAt DateTime @default(now())

  prices Price[]
}

model Store {
  id   Int    @id @default(autoincrement())
  name String  @unique

  prices Price[]
}

model Price {
  id    Int   @id @default(autoincrement())
  price Float

  productId Int
  storeId   Int

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  day DateTime

  @@unique([productId, storeId, day])
}
